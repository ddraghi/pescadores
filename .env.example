# Copiar a .env y completar. El .env NO se versiona.
#
# Todo se lee de variables de entorno, sin excepción: el día que esto pase al servidor
# del club, la migración es cambiar estos valores, no editar código.

# ── Base de datos ────────────────────────────────────────────────────────────
# Desarrollo local (Postgres en esta máquina):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pescadores?schema=public"
# Producción: la cadena que entregue el Postgres gestionado (región São Paulo).

# ── Sesión ───────────────────────────────────────────────────────────────────
# Clave para firmar la cookie de sesión. Generar una propia con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# ── URL pública ──────────────────────────────────────────────────────────────
APP_URL="http://localhost:9010"

# ── Mercado Pago ─────────────────────────────────────────────────────────────
# El webhook y el OAuth necesitan una URL pública: para probar en local se levanta
# un túnel temporal y se apunta APP_URL ahí.
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""

# ── Sonoff / eWeLink ─────────────────────────────────────────────────────────
# La nube de eWeLink se usa SÓLO para dar de alta un interruptor: traer la lista de
# aparatos de la cuenta del predio y su clave de red local. Nunca para operar. Operar
# es siempre por LAN, que es lo único que funciona con Starlink caído.
#
# Credenciales de la aplicación, de https://dev.ewelink.cc. El desarrollador personal
# es gratis y la credencial vence al año: renovarla es tarea de calendario.
EWELINK_APP_ID=""
EWELINK_APP_SECRET=""
# Región de la cuenta: us, eu, cn o as.
EWELINK_REGION="us"

# ── Correo saliente ──────────────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# ── Dispositivos ─────────────────────────────────────────────────────────────
# En desarrollo no hay Sonoff conectados: con esto en true las órdenes se aplican
# solas y los testigos responden, para poder ver las pantallas funcionando.
# En producción va en false: el estado real lo reporta el nodo de cada predio.
SIMULAR_DISPOSITIVOS="true"

# Dónde se guardan los archivos que sube el club (croquis). Fuera del build.
DIRECTORIO_DATOS=""
