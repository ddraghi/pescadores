# Copiar a .env y completar. El .env NO se versiona.
#
# Todo se lee de variables de entorno, sin excepción: el día que esto pase al servidor
# del club, la migración es cambiar estos valores, no editar código.

# ── Base de datos ────────────────────────────────────────────────────────────
# Desarrollo local (Postgres en esta máquina):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pescadores?schema=public"
# Producción: la cadena que entregue el Postgres gestionado (región São Paulo).

# ── Sesión ───────────────────────────────────────────────────────────────────
# Clave para firmar la cookie de sesión. Generar una propia con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# ── URL pública ──────────────────────────────────────────────────────────────
APP_URL="http://localhost:9010"

# ── Mercado Pago ─────────────────────────────────────────────────────────────
# El webhook y el OAuth necesitan una URL pública: para probar en local se levanta
# un túnel temporal y se apunta APP_URL ahí.
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""

# ── Sonoff / eWeLink ─────────────────────────────────────────────────────────
# Sólo para los accesos que no puedan controlarse por red local. En los predios con
# Starlink el interruptor va por LAN: una orden por la nube hace dos saltos satelitales.
EWELINK_APP_ID=""
EWELINK_APP_SECRET=""

# ── Correo saliente ──────────────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
