// Club de Pescadores San Rafael — esquema de datos.
//
// Decisión de fondo: IDENTIDAD y FICHA DE SOCIO van separadas (Persona / Socio).
// Una misma persona puede ser socio y ejercer un cargo —el Secretario del club es el
// socio 12338— mientras que un empleado o un concesionario no puede ser socio en
// absoluto (art. 22 del estatuto). Con una sola tabla eso no se puede expresar.
//
// Todo lo que pertenece a un predio lleva `predioId`: es el límite de alcance de los
// roles acotados (Jefe de predio, Portero, Control de paso, Maestranza).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Rol {
  ADMIN_GENERAL
  SECRETARIO
  TESORERO
  COBRADOR
  JEFE_PREDIO
  PORTERO
  CONTROL_PASO
  MAESTRANZA
  PROFESOR
  CONCESIONARIO
  MEDICO
  SOCIO
}

/// Las seis categorías del art. 11 del estatuto.
enum CategoriaSocio {
  ACTIVO
  CADETE
  VITALICIO
  TRANSEUNTE
  HONORARIO
  PRESIDENTE_HONORARIO
}

/// LICENCIA (art. 25): no paga cuota, pero para usar las instalaciones se lo trata
/// como NO SOCIO. EMPLAZADO (art. 28): tres cuotas impagas, diez días para regularizar.
enum EstadoSocio {
  AL_DIA
  MOROSO
  EMPLAZADO
  CESANTE
  SUSPENDIDO
  LICENCIA
  EXPULSADO
}

/// PORTERIA cobra y habilita. CONTROL sólo verifica aptitud y abre; nunca ve dinero.
enum TipoAcceso {
  PORTERIA
  CONTROL
}

enum TipoAlojamiento {
  BUNGALOW
  CABANA
  PARCELA
  CARPA
  CASILLA
  VIVIENDA
}

enum TipoEspacio {
  CANCHA
  QUINCHO
}

/// Alojamiento se reserva por NOCHE; canchas por HORA; quinchos por BLOQUE
/// (5 horas más hora adicional, según el tarifario del club).
enum UnidadReserva {
  NOCHE
  HORA
  BLOQUE
}

enum ModoReserva {
  ANTICIPADA
  EN_EL_MOMENTO
  AMBAS
}

enum EstadoReserva {
  ACTIVA
  CONFIRMADA
  CANCELADA
  AUSENTE
}

enum MedioPago {
  EFECTIVO
  DEBITO
  CREDITO
  TRANSFERENCIA
  MERCADO_PAGO
  DEBITO_AUTOMATICO
}

/// Las condiciones que discrimina el tarifario del club.
enum CondicionPersona {
  SOCIO
  NO_SOCIO
  JUBILADO
  DISCAPACIDAD
  MENOR_5
  ACOMPANANTE
  INVITADO
}

enum ResultadoIngreso {
  PERMITIDO
  RECHAZADO
}

enum EstadoCaja {
  ABIERTA
  CERRADA
}

enum EstadoCuota {
  PENDIENTE
  PAGADA
  VENCIDA
  CONDONADA
}

/// Para qué es cada interruptor. Además de describirlo, filtra las vistas: la pantalla
/// de accesos del Secretario no se llena con las luces del quincho.
enum PropositoDispositivo {
  ACCESO
  ILUMINACION
  BOMBA
  RIEGO
  OTRO
}

/// SIN_DATO no es un detalle: con bombas y riego, mostrar un estado viejo es peor que no
/// mostrar nada. El testigo se pone gris y no se deja tocar.
enum EstadoDispositivo {
  ENCENDIDO
  APAGADO
  SIN_DATO
}

/// Los aptos y derechos que condicionan el paso, todos con vigencia.
enum TipoHabilitacion {
  APTO_MEDICO
  DERECHO_PILETA
}

// ─────────────────────────────────────────────────────────────────────────────
// Identidad
// ─────────────────────────────────────────────────────────────────────────────

model Persona {
  id             String   @id @default(cuid())
  dni            String   @unique
  nombre         String
  email          String?
  telefono       String?
  fechaNacimiento DateTime?

  // Credenciales. `usuario` se guarda en minúsculas: es la clave de búsqueda del login.
  usuario        String?  @unique
  passwordHash   String?
  activo         Boolean  @default(true)

  // Marca de enrolamiento de huella. El template biométrico NUNCA se guarda acá:
  // vive cifrado en la PC del predio (mismo criterio que netgym).
  huellaEnrolada Boolean  @default(false)
  huellaDedo     String?

  roles          RolAsignado[]
  socio          Socio?

  cajas          Caja[]
  cobrosTomados  Cobro[]          @relation("CobroOperador")
  fichajes       Fichaje[]
  aptosEmitidos  Habilitacion[]   @relation("HabilitacionEmisor")
  carteraDe      Socio[]          @relation("SocioCobrador")
  accionesDispositivo AccionDispositivo[]
  gruposQueDicta      Grupo[]

  creadoEn       DateTime @default(now())
  actualizadoEn  DateTime @updatedAt

  @@index([usuario])
  @@index([nombre])
}

/// Un rol por fila. Los roles acotados llevan `predioId`; los de gobierno lo dejan nulo.
/// Una persona puede acumular roles (el Tesorero también es socio, por ejemplo).
model RolAsignado {
  id        String   @id @default(cuid())
  personaId String
  persona   Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
  rol       Rol
  predioId  String?
  predio    Predio?  @relation(fields: [predioId], references: [id])

  designadoPorId String?
  creadoEn  DateTime @default(now())

  @@unique([personaId, rol, predioId])
  @@index([rol])
}

model Socio {
  id            String         @id @default(cuid())
  numeroSocio   Int            @unique
  personaId     String         @unique
  persona       Persona        @relation(fields: [personaId], references: [id])

  categoria     CategoriaSocio @default(ACTIVO)
  estado        EstadoSocio    @default(AL_DIA)
  fechaIngreso  DateTime
  /// Sólo para TRANSEUNTE: el permiso caduca solo y con él los beneficios (art. 14 e).
  permisoHasta  DateTime?

  /// Grupo familiar. No es una entidad aparte: el grupo **es** el titular y los que
  /// cuelgan de él, y se llama como él. Nulo en el titular y en el socio suelto.
  titularId       String?
  titular         Socio?         @relation("GrupoFamiliar", fields: [titularId], references: [id])
  familiares      Socio[]        @relation("GrupoFamiliar")
  /// Parentesco con el titular. Sólo tiene sentido junto con `titularId`.
  parentesco      String?

  /// Cobrador asignado, cuando el socio está en una cartera de cobranza a domicilio.
  cobradorId    String?
  cobrador      Persona?       @relation("SocioCobrador", fields: [cobradorId], references: [id])

  observaciones String?

  cuotas        Cuota[]
  habilitaciones Habilitacion[]
  reservas      Reserva[]
  invitados     Invitado[]
  lotes         Lote[]
  cobros        Cobro[]
  actos         ActoEstatutario[]
  inscripciones InscripcionGrupo[]
  asistencias   Asistencia[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([estado])
  @@index([categoria])
  @@index([titularId])
}

/**
 * Constancia de cada acto sobre un socio: licencia, emplazamiento, cesantía, reingreso,
 * suspensión, expulsión, cambio de categoría.
 *
 * Va en su propia tabla y no en las observaciones del socio por dos motivos: las
 * observaciones son notas libres que la Secretaría edita, y el historial se perdería en
 * la primera edición; y porque el estatuto exige constancia de estos actos (art. 26 y
 * siguientes), así que tienen que quedar con fecha y con quién los registró.
 */
model ActoEstatutario {
  id        String   @id @default(cuid())
  socioId   String
  socio     Socio    @relation(fields: [socioId], references: [id], onDelete: Cascade)

  /// 'ESTADO' o 'CATEGORIA'.
  tipo      String
  desde     String
  hasta     String
  motivo    String?

  registradoPorId String?
  creadoEn  DateTime @default(now())

  @@index([socioId, creadoEn])
}

// ─────────────────────────────────────────────────────────────────────────────
// Estructura del club
// ─────────────────────────────────────────────────────────────────────────────

/// Los predios son ABM: se pueden agregar y quitar sin tocar código.
model Predio {
  id            String   @id @default(cuid())
  nombre        String
  slug          String   @unique
  direccion     String?
  /// Los predios remotos van por Starlink: el nodo local es obligatorio ahí.
  conexionSatelital Boolean @default(false)
  activo        Boolean  @default(true)
  orden         Int      @default(0)

  accesos       Acceso[]
  alojamientos  Alojamiento[]
  espacios      Espacio[]
  roles         RolAsignado[]
  actividades   ActividadPredio[]
  tarifas       ItemTarifario[]
  ingresos      Ingreso[]
  cobros        Cobro[]
  cajas         Caja[]
  egresos       Egreso[]
  fichajes      Fichaje[]
  lotes         Lote[]
  dispositivos  Dispositivo[]
  croquis       Croquis[]
  grupos        Grupo[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

/// Portería o punto de control. La tabla es una sola porque identificar, decidir,
/// abrir y registrar es idéntico; lo que cambia es el panel de cada rol.
model Acceso {
  id        String     @id @default(cuid())
  predioId  String
  predio    Predio     @relation(fields: [predioId], references: [id], onDelete: Cascade)
  nombre    String
  tipo      TipoAcceso

  /// El interruptor que abre este acceso, tomado del registro único de dispositivos.
  /// Antes eran dos campos sueltos acá; se unificaron para no tener dos lugares donde
  /// configurar lo mismo.
  dispositivoId String?
  dispositivo   Dispositivo? @relation(fields: [dispositivoId], references: [id])
  activo    Boolean    @default(true)

  /// Qué exige este puesto para dejar pasar. La pileta pide apto médico; la bajada de
  /// lanchas no. Se configura por acceso, en vez de estar cableado por nombre.
  exigeAptoMedico Boolean @default(false)
  /// Habilitación con vigencia que hace falta tener, si corresponde.
  exigeDerecho    TipoHabilitacion?

  ingresos  Ingreso[]
  cobros    Cobro[]
  cajas     Caja[]

  creadoEn  DateTime   @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([predioId, tipo])
}

/// Se reserva por NOCHE. Bungalows, cabañas, parcelas, carpas, casillas.
model Alojamiento {
  id            String          @id @default(cuid())
  predioId      String
  predio        Predio          @relation(fields: [predioId], references: [id], onDelete: Cascade)
  nombre        String
  tipo          TipoAlojamiento
  capacidadBase Int             @default(4)
  capacidadMax  Int             @default(6)
  modoReserva   ModoReserva     @default(ANTICIPADA)
  activo        Boolean         @default(true)

  reservas      Reserva[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([predioId, tipo])
}

/// Se reserva por HORA (canchas) o por BLOQUE (quinchos: 5 h más hora adicional).
/// `altaDemanda` activa cupo, ventana de anticipación y límite por socio.
model Espacio {
  id            String        @id @default(cuid())
  predioId      String
  predio        Predio        @relation(fields: [predioId], references: [id], onDelete: Cascade)
  nombre        String
  tipo          TipoEspacio
  unidad        UnidadReserva @default(HORA)
  /// Duración del bloque en horas cuando `unidad` es BLOQUE.
  bloqueHoras   Int?
  altaDemanda   Boolean       @default(false)
  /// Horas mínimas de anticipación para cancelar sin perder lo pagado.
  ventanaCancelacionHoras Int @default(12)
  activo        Boolean       @default(true)

  reservas      Reserva[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([predioId, tipo])
}

/// Fútbol, hockey, tenis, gimnasio, natación… Una actividad puede dictarse en más
/// de un predio (la colonia y la guardería de verano se dan en los dos de la ciudad).
model Actividad {
  id            String   @id @default(cuid())
  nombre        String
  /// "mensual" o "turno", según cómo se cobra en el tarifario.
  modalidad     String   @default("mensual")
  activo        Boolean  @default(true)

  predios       ActividadPredio[]
  grupos        Grupo[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

model ActividadPredio {
  actividadId String
  actividad   Actividad @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  predioId    String
  predio      Predio    @relation(fields: [predioId], references: [id], onDelete: Cascade)

  @@id([actividadId, predioId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Acceso
// ─────────────────────────────────────────────────────────────────────────────

/// Apto médico y derecho de pileta de temporada: las dos cosas que habilitan el paso
/// y las dos con vencimiento. El apto lo emite un médico; el derecho, una compra.
model Habilitacion {
  id          String           @id @default(cuid())
  socioId     String
  socio       Socio            @relation(fields: [socioId], references: [id], onDelete: Cascade)
  tipo        TipoHabilitacion

  autorizado  Boolean          @default(true)
  desde       DateTime
  hasta       DateTime
  novedades   String?

  /// Quién lo emitió. En el apto médico es el médico que revisó.
  emisorId    String?
  emisor      Persona?         @relation("HabilitacionEmisor", fields: [emisorId], references: [id])

  creadoEn    DateTime @default(now())

  @@index([socioId, tipo, hasta])
}

/// Log de cada paso por una portería o un punto de control, incluidos los rechazos:
/// saber quién llegó sin apto o con la cuota vencida es justamente el dato que sirve.
model Ingreso {
  id          String           @id @default(cuid())
  accesoId    String
  acceso      Acceso           @relation(fields: [accesoId], references: [id])
  predioId    String
  predio      Predio           @relation(fields: [predioId], references: [id])

  personaId   String?
  /// Nombre de quien ingresó, congelado: sirve para los no socios sin ficha.
  nombre      String
  condicion   CondicionPersona @default(SOCIO)

  resultado   ResultadoIngreso
  motivo      String?
  cobroId     String?          @unique
  cobro       Cobro?           @relation(fields: [cobroId], references: [id])

  /// Momento en el equipo de la portería y momento en que llegó al servidor. Con el
  /// nodo trabajando sin enlace pueden diferir; el desvío importa para el arqueo.
  ocurridoEn  DateTime
  registradoEn DateTime        @default(now())

  @@index([predioId, ocurridoEn])
  @@index([personaId])
}

/// Acompañantes e invitados que el socio declara. Él responde por ellos (art. 26).
model Invitado {
  id        String   @id @default(cuid())
  socioId   String
  socio     Socio    @relation(fields: [socioId], references: [id], onDelete: Cascade)
  nombre    String
  dni       String?
  creadoEn  DateTime @default(now())

  @@index([socioId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Barrio de viviendas de fin de semana (El Nihuil)
// ─────────────────────────────────────────────────────────────────────────────

/// Parcelas que el club cede en concesión precaria para que el socio construya su
/// casa de fin de semana (art. 1 del reglamento). NO se reservan: se adjudican.
model Lote {
  id             String   @id @default(cuid())
  predioId       String
  predio         Predio   @relation(fields: [predioId], references: [id])
  numero         String
  fila           String?
  adjudicatarioId String?
  adjudicatario  Socio?   @relation(fields: [adjudicatarioId], references: [id])
  fechaAdjudicacion DateTime?

  autorizaciones AutorizacionEstadia[]
  transferencias TransferenciaLote[]

  creadoEn       DateTime @default(now())
  actualizadoEn  DateTime @updatedAt

  @@unique([predioId, numero])
}

/// Permiso para que terceros usen la vivienda: hasta 15 días, con los nombres
/// declarados. Sin esto la portería NO los deja pasar (arts. 9 y 10 del reglamento).
model AutorizacionEstadia {
  id        String   @id @default(cuid())
  loteId    String
  lote      Lote     @relation(fields: [loteId], references: [id], onDelete: Cascade)
  personas  String[]
  desde     DateTime
  hasta     DateTime
  aprobada  Boolean  @default(false)
  creadoEn  DateTime @default(now())

  @@index([loteId, hasta])
}

// ─────────────────────────────────────────────────────────────────────────────
// Reservas
// ─────────────────────────────────────────────────────────────────────────────

model Reserva {
  id            String        @id @default(cuid())
  socioId       String
  socio         Socio         @relation(fields: [socioId], references: [id])

  alojamientoId String?
  alojamiento   Alojamiento?  @relation(fields: [alojamientoId], references: [id])
  espacioId     String?
  espacio       Espacio?      @relation(fields: [espacioId], references: [id])

  desde         DateTime
  hasta         DateTime
  personas      Int           @default(1)
  estado        EstadoReserva @default(ACTIVA)
  /// El Jefe de predio puede reservar por encima de la disponibilidad pública.
  prioritaria   Boolean       @default(false)
  observaciones String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([desde, hasta])
  @@index([socioId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Dinero
// ─────────────────────────────────────────────────────────────────────────────

/// Precio de un concepto, cruzado por predio, condición de la persona y vigencia.
/// `predioId` nulo significa que vale para todos (el derecho de pileta de temporada
/// vale para los dos predios de la ciudad, por ejemplo).
model ItemTarifario {
  id          String           @id @default(cuid())
  concepto    String
  predioId    String?
  predio      Predio?          @relation(fields: [predioId], references: [id])
  condicion   CondicionPersona @default(SOCIO)
  precio      Decimal          @db.Decimal(12, 2)
  vigenciaDesde DateTime
  vigenciaHasta DateTime?

  /// Sólo para la cuota social: a qué categoría de socio le corresponde este precio.
  /// Que una categoría NO tenga item es lo que define que no paga cuota — así el club
  /// decide cargando o no el precio, en vez de que lo decidamos nosotros en el código.
  categoriaSocio CategoriaSocio?

  /// Cuota de grupo familiar: la paga el titular una vez por todo el grupo, en lugar de
  /// que pague cada integrante por separado.
  porGrupoFamiliar Boolean @default(false)

  creadoEn    DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([concepto, condicion, vigenciaDesde])
  @@index([categoriaSocio, porGrupoFamiliar])
}

model Cuota {
  id          String      @id @default(cuid())
  socioId     String
  socio       Socio       @relation(fields: [socioId], references: [id], onDelete: Cascade)
  /// Formato "AAAA-MM".
  periodo     String
  monto       Decimal     @db.Decimal(12, 2)
  estado      EstadoCuota @default(PENDIENTE)
  vencimiento DateTime

  /// Qué se le cobró: "Cuota social · Activo" o "Cuota social · Grupo familiar".
  concepto    String      @default("Cuota social")
  /// Con qué cobro se saldó. Nulo mientras esté pendiente.
  cobroId     String?
  cobro       Cobro?      @relation(fields: [cobroId], references: [id])
  pagadaEn    DateTime?

  creadoEn    DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([socioId, periodo])
  @@index([estado])
  @@index([periodo])
}

/// Turno de caja de un portero, o rendición de un cobrador. El arqueo discrimina
/// por medio de pago, y marca aparte lo cobrado sin enlace.
model Caja {
  id          String     @id @default(cuid())
  personaId   String
  persona     Persona    @relation(fields: [personaId], references: [id])
  predioId    String
  predio      Predio     @relation(fields: [predioId], references: [id])
  accesoId    String?
  acceso      Acceso?    @relation(fields: [accesoId], references: [id])

  estado      EstadoCaja @default(ABIERTA)
  abiertaEn   DateTime   @default(now())
  cerradaEn   DateTime?
  /// Totales declarados por quien cierra, para contrastar con lo registrado.
  arqueo      Json?

  cobros      Cobro[]

  @@index([predioId, estado])
}

model Cobro {
  id          String    @id @default(cuid())

  /// Clave de idempotencia generada en el origen. Es lo que impide que un reintento
  /// sobre un enlace inestable cobre dos veces.
  claveUnica  String    @unique

  socioId     String?
  socio       Socio?    @relation(fields: [socioId], references: [id])
  /// Nombre congelado: la mayoría de los cobros de portería son a no socios.
  pagador     String

  predioId    String
  predio      Predio    @relation(fields: [predioId], references: [id])
  accesoId    String?
  acceso      Acceso?   @relation(fields: [accesoId], references: [id])
  cajaId      String?
  caja        Caja?     @relation(fields: [cajaId], references: [id])

  operadorId  String
  operador    Persona   @relation("CobroOperador", fields: [operadorId], references: [id])

  medioPago   MedioPago
  total       Decimal   @db.Decimal(12, 2)
  /// Detalle: concepto, cantidad y precio unitario de cada línea.
  items       Json

  /// Cobrado con el nodo trabajando sin enlace. El Tesorero los ve diferenciados.
  offline     Boolean   @default(false)
  /// Datos fiscales para emitir el comprobante ARCA más adelante, sin rehacer nada.
  comprobante Json?

  ingreso     Ingreso?
  cuotas      Cuota[]

  ocurridoEn  DateTime
  registradoEn DateTime @default(now())

  @@index([predioId, ocurridoEn])
  @@index([socioId])
}

/// Planilla simple de egresos, que es lo único que se pidió por ahora.
model Egreso {
  id          String   @id @default(cuid())
  predioId    String?
  predio      Predio?  @relation(fields: [predioId], references: [id])
  fecha       DateTime
  concepto    String
  monto       Decimal  @db.Decimal(12, 2)
  comprobante String?
  creadoEn    DateTime @default(now())

  @@index([fecha])
}

// ─────────────────────────────────────────────────────────────────────────────
// Personal
// ─────────────────────────────────────────────────────────────────────────────

/// Control horario que consulta el Jefe de predio sobre su gente.
model Fichaje {
  id        String   @id @default(cuid())
  personaId String
  persona   Persona  @relation(fields: [personaId], references: [id])
  predioId  String
  predio    Predio   @relation(fields: [predioId], references: [id])
  entrada   DateTime
  salida    DateTime?

  @@index([predioId, entrada])
}

// ─────────────────────────────────────────────────────────────────────────────
// Dispositivos
// ─────────────────────────────────────────────────────────────────────────────

/**
 * Un interruptor Sonoff de un canal: una luz, una bomba, el riego, una barrera.
 *
 * Registro ÚNICO. Los accesos apuntan acá en vez de guardar su propia configuración,
 * para que no haya dos lugares donde definir el mismo aparato.
 */
model Dispositivo {
  id        String   @id @default(cuid())
  predioId  String
  predio    Predio   @relation(fields: [predioId], references: [id], onDelete: Cascade)
  nombre    String
  /// Identificador del aparato en eWeLink. La aplicación de eWeLink se usa sólo para
  /// darlo de alta y vincularlo; de ahí en adelante se opera desde acá.
  deviceId  String   @unique
  proposito PropositoDispositivo @default(OTRO)

  /// Cómo se le habla: "relay_usb", "sonoff_lan" o "sonoff_cloud". En los predios
  /// satelitales tiene que ser local (ver la validación en acciones/dispositivos.ts).
  via       String   @default("sonoff_lan")
  /// IP en la red local o puerto serie, según la vía.
  direccion String?
  /// Dónde está físicamente, en palabras: "tablero del quincho", "casilla de bombas".
  ubicacion String?

  /// Los que pueden hacer daño piden confirmación antes de accionarse.
  requiereConfirmacion Boolean @default(false)
  activo    Boolean  @default(true)

  /// Último estado conocido y cuándo se supo. Si la lectura es vieja, la pantalla
  /// muestra SIN_DATO en vez de arriesgar un estado que ya no es cierto.
  estado    EstadoDispositivo @default(SIN_DATO)
  estadoEn  DateTime?

  /// Ubicación en el croquis, en PORCENTAJE del ancho y del alto: así se ve igual en el
  /// monitor de la oficina y en un celular.
  croquisId String?
  croquis   Croquis? @relation(fields: [croquisId], references: [id])
  x         Float?
  y         Float?

  accesos   Acceso[]
  horarios  HorarioDispositivo[]
  acciones  AccionDispositivo[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([predioId, proposito])
}

/// Croquis de un sector del predio. Son varios por predio: El Nihuil no entra en uno.
model Croquis {
  id       String @id @default(cuid())
  predioId String
  predio   Predio @relation(fields: [predioId], references: [id], onDelete: Cascade)
  nombre   String
  /// Nombre del archivo guardado. Se sirve por /api/croquis/[archivo], no desde public:
  /// los archivos subidos no pueden vivir en el árbol del build.
  archivo  String
  orden    Int    @default(0)

  dispositivos Dispositivo[]

  creadoEn DateTime @default(now())

  @@index([predioId, orden])
}

/**
 * Encendido y apagado programado.
 *
 * Lo ejecuta la PC de la portería, que está encendida las 24 horas, NO el servidor: si
 * el enlace se cae a las 6 de la mañana, el riego tiene que arrancar igual. El servidor
 * sólo define el horario y se lo baja al nodo.
 */
model HorarioDispositivo {
  id            String @id @default(cuid())
  dispositivoId String
  dispositivo   Dispositivo @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)

  /// "06:00", hora local del predio.
  hora     String
  /// Verdadero enciende, falso apaga.
  encender Boolean
  /// Días de la semana, 1 = lunes. Vacío significa todos los días.
  dias     Int[]
  activo   Boolean @default(true)

  creadoEn DateTime @default(now())

  @@index([dispositivoId])
}

/**
 * Quién accionó qué, cuándo y desde dónde.
 *
 * Con bombas y riego en juego, y tres roles con permiso para operar, esto no es un lujo:
 * si una bomba trabajó de más o el riego no arrancó, tiene que poder saberse.
 *
 * También es la cola de órdenes pendientes que el nodo del predio va a buscar.
 */
model AccionDispositivo {
  id            String @id @default(cuid())
  dispositivoId String
  dispositivo   Dispositivo @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)

  personaId String?
  persona   Persona? @relation(fields: [personaId], references: [id])

  /// "ENCENDER" o "APAGAR". Siempre absoluto, nunca "invertir": si una orden se
  /// duplica sobre un enlace inestable, no pasa nada.
  accion String
  /// "MANUAL", "HORARIO" o "SISTEMA".
  origen String @default("MANUAL")

  /// Nulo mientras está pendiente. Lo completa el nodo cuando la ejecutó.
  aplicadaEn DateTime?
  error      String?

  creadoEn DateTime @default(now())

  @@index([dispositivoId, creadoEn])
  @@index([aplicadaEn])
}

// ─────────────────────────────────────────────────────────────────────────────
// Actividades: grupos, horarios y asistencia
// ─────────────────────────────────────────────────────────────────────────────

/// Un grupo de una actividad, a cargo de un profesor: "Fútbol infantil", "Natación
/// adultos". El profesor arma los suyos y les carga los horarios.
model Grupo {
  id          String    @id @default(cuid())
  actividadId String
  actividad   Actividad @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  predioId    String?
  predio      Predio?   @relation(fields: [predioId], references: [id])

  nombre      String
  profesorId  String?
  profesor    Persona?  @relation(fields: [profesorId], references: [id])
  /// Cuántos entran. Cero significa sin límite.
  cupo        Int       @default(0)
  activo      Boolean   @default(true)

  horarios      HorarioGrupo[]
  inscripciones InscripcionGrupo[]
  asistencias   Asistencia[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([actividadId])
  @@index([profesorId])
}

model HorarioGrupo {
  id      String @id @default(cuid())
  grupoId String
  grupo   Grupo  @relation(fields: [grupoId], references: [id], onDelete: Cascade)

  /// 1 = lunes.
  dia     Int
  hora    String
  minutos Int    @default(60)

  @@index([grupoId])
}

model InscripcionGrupo {
  id      String @id @default(cuid())
  grupoId String
  grupo   Grupo  @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  socioId String
  socio   Socio  @relation(fields: [socioId], references: [id], onDelete: Cascade)

  desde   DateTime @default(now())
  activa  Boolean  @default(true)

  @@unique([grupoId, socioId])
  @@index([socioId])
}

/// Asistencia de una fecha. Se guarda sólo lo que el profesor marca.
model Asistencia {
  id      String   @id @default(cuid())
  grupoId String
  grupo   Grupo    @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  socioId String
  socio   Socio    @relation(fields: [socioId], references: [id], onDelete: Cascade)

  /// Día de la clase, sin hora.
  fecha    DateTime
  presente Boolean  @default(true)

  @@unique([grupoId, socioId, fecha])
  @@index([grupoId, fecha])
}

/**
 * Transferencia de las mejoras de un lote del barrio de fin de semana.
 *
 * El reglamento las mide en cantidad de cuotas sociales (arts. 19 y 20) y exige que el
 * nuevo adjudicatario quede encuadrado antes de aprobarla (art. 18).
 */
model TransferenciaLote {
  id       String @id @default(cuid())
  loteId   String
  lote     Lote   @relation(fields: [loteId], references: [id], onDelete: Cascade)

  /// Nombres congelados: el socio puede dejar de serlo y la constancia tiene que quedar.
  vendedor  String
  comprador String
  /// Derechos de transferencia y de adjudicación, en cantidad de cuotas sociales.
  cuotasTransferencia Int @default(0)
  cuotasAdjudicacion  Int @default(0)
  /// Entre familiares directos, por única vez, va sin cargo (art. 22 del anexo).
  entreFamiliares Boolean @default(false)

  fecha    DateTime
  aprobada Boolean  @default(false)
  notas    String?

  creadoEn DateTime @default(now())

  @@index([loteId])
}
